# Copier ce fichier en .env sur le VPS : /var/www/horizonecole/.env
# Puis remplir les valeurs réelles

NODE_ENV=production
PORT=4001

# Base de données Aiven PostgreSQL
DATABASE_URL=postgres://avnadmin:MOT_DE_PASSE@host:port/defaultdb?sslmode=require

# JWT (générer avec : openssl rand -base64 64)
JWT_SECRET=changer-cette-valeur-par-un-secret-long-et-aleatoire
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS / Frontend
CORS_ORIGIN=https://horizonecole.com
FRONTEND_URL=https://horizonecole.com

# Fuseau horaire de l'école
SCHOOL_TIMEZONE=Africa/Abidjan

# Email (SMTP sortant — laisser vide si non configuré)
# Hostinger : smtp.hostinger.com, port 465 en TLS implicite (EMAIL_SECURE=true).
# Le port 587 fonctionne aussi, mais avec EMAIL_SECURE=false (STARTTLS).
#
# EMAIL_USER doit être une boîte réellement créée dans hPanel : posséder le
# domaine ne suffit pas. Hostinger impose en outre que l'expéditeur soit ce
# compte — c'est pourquoi le service mail construit le « from » à partir de lui.
#
# ⚠️ ENTOURER LE MOT DE PASSE DE GUILLEMETS s'il contient # ou des espaces :
#    sans eux, tout ce qui suit un « # » est lu comme un commentaire et
#    l'authentification échoue avec un « 535 » difficile à rattacher à sa cause.
#    Exemple : EMAIL_PASSWORD="Mot#DePasse@2026"
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=support@votre-domaine.com
EMAIL_PASSWORD=""
EMAIL_FROM_NAME=HorizonEcole

# Destinataire des demandes du site vitrine (démonstration, devis, contact).
# À défaut, EMAIL_USER est utilisé.
LEADS_EMAIL_TO=info@votre-domaine.com
