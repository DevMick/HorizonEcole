# Copier ce fichier en .env sur le VPS : /var/www/horizonecole/.env
# Puis remplir les valeurs réelles

NODE_ENV=production
PORT=4001

# Base de données Aiven PostgreSQL
DATABASE_URL=postgres://avnadmin:MOT_DE_PASSE@host:port/defaultdb?sslmode=require

# JWT (générer avec : openssl rand -base64 64)
JWT_SECRET=changer-cette-valeur-par-un-secret-long-et-aleatoire
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS / Frontend
CORS_ORIGIN=https://horizonecole.com
FRONTEND_URL=https://horizonecole.com

# Fuseau horaire de l'école
SCHOOL_TIMEZONE=Africa/Abidjan

# Email (SMTP sortant — laisser vide si non configuré)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=HorizonEcole
