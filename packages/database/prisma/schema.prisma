// Lignes de détail de paie
model payroll_items {
  id              String           @id @default(uuid())
  payroll_id      String
  item_type       String           @db.VarChar(50) // BASE, ALLOWANCE, SENIORITY, DEDUCTION, ABSENCE, ADVANCE
  item_label      String           @db.VarChar(200)
  amount          Decimal          @db.Decimal(10, 2)
  allowance_id    String? // Si c'est une prime/indemnité
  is_taxable      Boolean          @default(true)
  notes           String?          @db.Text
  created_at      DateTime         @default(now())
  monthly_payroll monthly_payrolls @relation(fields: [payroll_id], references: [id], onDelete: Cascade)

  @@index([payroll_id])
  @@index([item_type])
  @@map("payroll_items")
}

// Paiements effectués
model payroll_payments {
  id              String           @id @default(uuid())
  payroll_id      String
  amount          Decimal          @db.Decimal(10, 2)
