model SchoolClass {
  id    String  @id
  name  String  @db.VarChar(50)
  level String? @db.VarChar(50)
  /// Cycle d'enseignement de la classe. `SECONDAIRE` (6e → Tle) est la valeur
  /// historique et reste le défaut : toutes les classes existantes la portent.
  /// `PRIMAIRE` (CP1 → CM2) bascule la classe sur le module primaire, qui a sa
  /// propre grille de matières, ses compositions et son calcul de moyenne
  /// (somme des notes / diviseur) — voir `primary_class_settings`.
  cycle SchoolCycle @default(SECONDAIRE)

  /// Condition de paiement affectée à cette classe — définit les tranches
  /// (pourcentage + délai en jours) appliquées automatiquement à l'inscription.
  /// Null = retombée sur l'échéancier modèle par niveau, puis paiement unique.
  payment_condition_id String?
  payment_condition    payment_conditions? @relation(fields: [payment_condition_id], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  attendances          attendances[]
  classSubjects        class_subjects[]
  inscriptions         inscriptions[]
  schedules            schedules[]
  students             Student[]
  timetables           class_timetables[]
  teacher_assignments  teacher_class_assignments[]
  custom_payment_plans custom_payment_plans[]
  invoices             invoices[]
  grades               grades[]
  student_absences     student_absences[]
  main_teachers        class_main_teachers[]
  attendance_sessions  attendance_sessions[]
  evaluation_types     evaluation_types[]
  conduct_grades       conduct_grades[]
  conduct_overrides    conduct_absence_overrides[]
  bulletin_releases    bulletin_releases[]
  primary_settings     primary_class_settings?
  primary_subjects     primary_class_subjects[]
  primary_evaluations  primary_evaluations[]

  @@map("classes")

  /// Établissement propriétaire — cloisonnement multi-établissements.
  ///
  /// Déclaré optionnel *ici seulement* : la colonne est NOT NULL en base. Le
  /// champ n'est jamais fourni par l'appelant, il est injecté par l'extension
