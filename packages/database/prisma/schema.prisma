// Paies mensuelles
model monthly_payrolls {
  id                  String                        @id @default(uuid())
  teacher_id          String
  month               Int
  year                Int
  status              PayrollStatus                 @default(DRAFT)
  base_salary         Decimal                       @db.Decimal(10, 2)
  total_allowances    Decimal                       @default(0) @db.Decimal(10, 2)
  seniority_bonus     Decimal                       @default(0) @db.Decimal(10, 2)
  total_brut          Decimal                       @db.Decimal(10, 2)
  deductions          Decimal                       @default(0) @db.Decimal(10, 2)
  net_payable         Decimal                       @db.Decimal(10, 2)
  hours_worked        Decimal?                      @db.Decimal(5, 2) // Pour horaire
  absences_deduction  Decimal                       @default(0) @db.Decimal(10, 2)
  advances_deduction  Decimal                       @default(0) @db.Decimal(10, 2)
  prorata_amount      Decimal?                      @db.Decimal(10, 2) // Montant du prorata
  prorata_days        Int? // Jours travaillés
  prorata_total_days  Int? // Jours totaux du mois
  cnps_salarie        Decimal?                      @db.Decimal(10, 2)
  cnps_employeur      Decimal?                      @db.Decimal(10, 2)
  igr                 Decimal?                      @db.Decimal(10, 2)
  validated_by        String?
  validated_at        DateTime?
  created_by          String?
  created_at          DateTime                      @default(now())
  updated_at          DateTime                      @default(now()) @updatedAt
  teacher             teachers                      @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  validatedBy         User?                         @relation("PayrollValidator", fields: [validated_by], references: [id], onDelete: SetNull)
  createdBy           User?                         @relation("PayrollCreator", fields: [created_by], references: [id], onDelete: SetNull)
  items               payroll_items[]
  payments            payroll_payments[]
  correction_requests payroll_correction_requests[]

  @@unique([teacher_id, month, year])
  @@index([teacher_id])
  @@index([month, year])
  @@index([status])
  @@map("monthly_payrolls")

  /// Établissement propriétaire — cloisonnement multi-établissements.
