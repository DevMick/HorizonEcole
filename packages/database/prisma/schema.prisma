// ============================================
// CYCLE PRIMAIRE (CP1 → CM2)
// ============================================
//
// Le primaire ne réutilise pas `grades` / `evaluation_types` : son calcul est
// d'une autre nature. Là où le secondaire fait une moyenne pondérée par
// coefficient sur des notes toutes ramenées sur 20, le primaire additionne des
// notes de barèmes hétérogènes (MATH /50, DICTEE /20, …) et divise la somme par
// un diviseur propre au niveau — CM1 : (50 + 50 + 20 + 50) / 8,5 = /20.
// Mélanger les deux dans les mêmes tables aurait forcé chaque lecture du
// secondaire à se demander de quel cycle elle parle ; les tables sont donc
// séparées, et seuls les référentiels communs (classes, élèves, matières,
// enseignants, années) sont partagés.

/// Paramètres de calcul de la moyenne d'une classe du primaire, dérivés du
/// profil du niveau (CP1 → CM2) puis modifiables par l'administration.
///
/// `divisor` vaut, par construction, « somme des barèmes des matières /
/// average_scale » : c'est ce qui ramène le total brut sur l'échelle de la
/// classe (10 au CP/CE, 20 au CM).
model primary_class_settings {
  id                   String   @id @default(uuid())
  class_id             String   @unique
  divisor              Decimal  @db.Decimal(6, 2)
  average_scale        Int      @default(20)
  moyenne_admission    Decimal  @db.Decimal(5, 2)
  moyenne_redoublement Decimal  @db.Decimal(5, 2)
  created_at           DateTime @default(now())
  updated_at           DateTime @default(now()) @updatedAt

  class SchoolClass @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@map("primary_class_settings")

  /// Établissement propriétaire — cloisonnement multi-établissements.
  ///
  /// Déclaré optionnel *ici seulement* : la colonne est NOT NULL en base. Le
  /// champ n'est jamais fourni par l'appelant, il est injecté par l'extension
  /// Prisma à partir du contexte de la requête (cf. packages/database/src/
  /// tenant-extension.ts). L'optionalité évite d'exiger de chaque `create` une
  /// valeur qu'il n'a pas à connaître ; la contrainte NOT NULL reste le
  /// garde-fou : une écriture qui échapperait à l'extension est rejetée par la
  /// base au lieu de créer une ligne orpheline.
  establishment_id String?
  establishment    Establishment? @relation(fields: [establishment_id], references: [id], onDelete: Cascade)

  @@index([establishment_id])
}

