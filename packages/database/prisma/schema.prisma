generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Type d'enseignement d'un établissement. Il détermine les niveaux de
/// classes ouverts et les modules visibles : un lycée couvre aussi le
/// collège (6e → Tle), le primaire va du CP1 au CM2.
enum SchoolType {
  PRIMAIRE
  COLLEGE
  LYCEE
}

/// Mode de calcul d'une tranche dans une condition de paiement.
/// PERCENT = pourcentage du montant total ; BALANCE = solde restant (dernière tranche).
enum PaymentValueType {
  PERCENT
  BALANCE
}

/// Établissement scolaire — racine du cloisonnement.
///
/// Toutes les données métier lui appartiennent, et l'isolation n'est pas
/// laissée à la vigilance de chaque service : le client Prisma injecte le
/// filtre `establishment_id` sur toutes les requêtes (cf. packages/database).
model Establishment {
  id         String     @id @default(uuid())
  name       String     @db.VarChar(200)
  /// Identifiant court et lisible de l'école, unique sur la plateforme.
  code       String     @unique @db.VarChar(50)
  schoolType SchoolType @map("school_type")
  email      String     @db.VarChar(255)
  phone      String?    @db.VarChar(30)
  address    String?
  city       String?    @db.VarChar(120)
  country    String?    @db.VarChar(120)
  motto      String?    @db.VarChar(200)
  /// Direction Régionale de l'Éducation Nationale dont dépend l'école.
  /// Propre au primaire : l'en-tête des fiches de classement officielles la
  /// porte, avec le secteur pédagogique. Nul pour un collège ou un lycée.
  directionRegionale String? @map("direction_regionale") @db.VarChar(150)
  /// Secteur pédagogique de rattachement, même usage que ci-dessus.
  secteurPedagogique String? @map("secteur_pedagogique") @db.VarChar(150)
  logoUrl    String?    @map("logo_url")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at")

  academic_years               AcademicYear[]
  classes                      SchoolClass[]
  students                     Student[]
  users                        User[]
  parents                      parents[]
  teachers                     teachers[]
  subjects                     subjects[]
  classrooms                   classrooms[]
  horaires                     horaires[]
  payment_types                payment_types[]
  payment_conditions           payment_conditions[]
  school_fee_rates             school_fee_rates[]
  roles                        Role[]
  semesters                    semesters[]
  expenses                     expenses[]
  budgets                      budgets[]
  budget_lines                 budget_lines[]
  payroll_settings             payroll_settings[]
  conduct_settings             conduct_settings[]
  audit_logs                   audit_logs[]
  custom_payment_plans         custom_payment_plans[]
  invoices                     invoices[]
  evaluation_types             evaluation_types[]
  primary_evaluations          primary_evaluations[]
  attendances                  attendances[]
  attendance_sessions          attendance_sessions[]
  attendance_summaries         attendance_summaries[]
  schedules                    schedules[]
  class_timetables             class_timetables[]
  inscriptions                 inscriptions[]
  grades                       grades[]
  student_payments             student_payments[]
  monthly_payrolls             monthly_payrolls[]
  advance_payments             advance_payments[]
  teacher_absences             teacher_absences[]
  teacher_hours                teacher_hours[]
  disciplinary_incidents       disciplinary_incidents[]
  student_absences             student_absences[]
  conduct_grades               conduct_grades[]
  bulletin_releases            bulletin_releases[]
  class_subjects               class_subjects[]
  student_parents              student_parents[]
  teacher_class_assignments    teacher_class_assignments[]
  class_main_teachers          class_main_teachers[]
  primary_class_settings       primary_class_settings[]
  primary_class_subjects       primary_class_subjects[]
  primary_grades               primary_grades[]

  @@map("establishments")
}

model AcademicYear {
  id        String   @id
  name      String   @db.VarChar(9)
  startYear Int      @map("start_year")
  endYear   Int      @map("end_year")
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")

  budgets              budgets[]
  budget_lines         budget_lines[]
  schedules            schedules[]
  inscriptions         inscriptions[]
  student_payments     student_payments[]
  custom_payment_plans custom_payment_plans[]
  invoices             invoices[]
  timetables           class_timetables[]
  teacher_assignments  teacher_class_assignments[]
  semesters            semesters[]
  grades               grades[]
  student_absences     student_absences[]
  class_main_teachers  class_main_teachers[]
  attendance_sessions  attendance_sessions[]
  evaluation_types     evaluation_types[]
  conduct_settings     conduct_settings?
  conduct_grades       conduct_grades[]
  conduct_overrides    conduct_absence_overrides[]
  bulletin_releases    bulletin_releases[]
  primary_evaluations  primary_evaluations[]

  @@map("academic_years")

  /// Établissement propriétaire — cloisonnement multi-établissements.
  ///
  /// Déclaré optionnel *ici seulement* : la colonne est NOT NULL en base. Le
  /// champ n'est jamais fourni par l'appelant, il est injecté par l'extension
  /// Prisma à partir du contexte de la requête (cf. packages/database/src/
  /// tenant-extension.ts). L'optionalité évite d'exiger de chaque `create` une
  /// valeur qu'il n'a pas à connaître ; la contrainte NOT NULL reste le
  /// garde-fou : une écriture qui échapperait à l'extension est rejetée par la
  /// base au lieu de créer une ligne orpheline.
  establishment_id String?
  establishment    Establishment? @relation(fields: [establishment_id], references: [id], onDelete: Cascade)

  @@index([establishment_id])
  @@unique([establishment_id, name])
}

