// Demandes de correction de paie (enseignant → admin)
model payroll_correction_requests {
  id              String           @id @default(uuid())
  payroll_id      String
  teacher_id      String
  reason          String           @db.Text
  status          String           @default("PENDING") @db.VarChar(50) // PENDING, APPROVED, REJECTED
  response        String?          @db.Text
  responded_by    String?
  responded_at    DateTime?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @default(now()) @updatedAt
  monthly_payroll monthly_payrolls @relation(fields: [payroll_id], references: [id], onDelete: Cascade)
  respondedBy     User?            @relation("PayrollCorrectionResponder", fields: [responded_by], references: [id], onDelete: SetNull)

  @@index([payroll_id])
  @@index([teacher_id])
  @@index([status])
  @@map("payroll_correction_requests")
}
