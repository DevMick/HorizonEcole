---
import { MODULES, formaterMontant, type Cycle } from '@/lib/pricing';

interface Props {
  cycle: Cycle;
  titre?: boolean;
}
const { cycle, titre = true } = Astro.props;
const module = MODULES[cycle];
---

<div>
  {titre && (
    <div class="mb-4">
      <h3 class="text-display-md">Module {module.nom}</h3>
      <p class="text-legende text-ardoise-600">{module.niveaux} · {module.sousTitre}</p>
    </div>
  )}

  <!-- Desktop : tableau. Le défilement, s'il a lieu, reste dans ce conteneur. -->
  <div class="table-defilante hidden md:block">
    <table class="w-full border-collapse text-left">
      <caption class="sr-only">
        Tarifs du module {module.nom}, en FCFA hors taxes
      </caption>
      <thead>
        <tr class="bg-ink-600 text-white">
          <th scope="col" class="rounded-tl-carte px-4 py-3 text-legende font-semibold">Taille de l’établissement</th>
          <th scope="col" class="px-4 py-3 text-legende font-semibold">Effectif</th>
          <th scope="col" class="px-4 py-3 text-legende font-semibold">Mise en service</th>
          <th scope="col" class="rounded-tr-carte bg-ink-700 px-4 py-3 text-right text-legende font-semibold">
            Abonnement annuel
          </th>
        </tr>
      </thead>
      <tbody>
        {module.tranches.map((tranche, i) => (
          <tr class={i % 2 ? 'bg-ardoise-0' : 'bg-white'}>
            <td class="border-b border-ardoise-200 px-4 py-3">
              <span class="block font-semibold text-ink-900">{tranche.nom}</span>
              <span class="block text-[0.78rem] text-ardoise-500">{tranche.description}</span>
            </td>
            <td class="border-b border-ardoise-200 px-4 py-3 text-legende text-ardoise-700">
              {tranche.libelleEffectif}
            </td>
            <td class="border-b border-ardoise-200 px-4 py-3">
              <span class="badge-craie">Offerte</span>
            </td>
            <td class="border-b border-ardoise-200 bg-ink-50 px-4 py-3 text-right">
              <span class="chiffre text-[1.05rem]">{formaterMontant(tranche.abonnement)}</span>
              <span class="block text-[0.72rem] text-ardoise-500">FCFA HT / an</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Mobile : une carte par tranche. Jamais de défilement horizontal. -->
  <div class="space-y-4 md:hidden">
    {module.tranches.map((tranche) => (
      <div class="carte carte-nue">
        <div class="flex items-baseline justify-between gap-3">
          <div>
            <p class="font-semibold text-ink-900">{tranche.nom}</p>
            <p class="text-[0.78rem] text-ardoise-500">{tranche.libelleEffectif}</p>
          </div>
          <p class="shrink-0 text-right">
            <span class="chiffre text-[1.15rem]">{formaterMontant(tranche.abonnement)}</span>
            <span class="block text-[0.72rem] text-ardoise-500">FCFA / an</span>
          </p>
        </div>
        <p class="mt-3 flex items-center gap-2 border-t border-ardoise-200 pt-3 text-legende text-ardoise-600">
          <span class="badge-craie">Offerte</span>
          Mise en service la première année
        </p>
      </div>
    ))}
  </div>
</div>
