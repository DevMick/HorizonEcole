---
import { CONTACT, PIED_DE_PAGE } from '@/lib/navigation';
const annee = 2026;
---

<footer class="mt-auto bg-ink-900 text-white">
  <!-- Filet tricolore : reprise du dégradé du méga-menu, il referme la page
       sur la même signature que celle qui l'ouvre. -->
  <div class="h-[3px] bg-gradient-to-r from-ink-600 via-craie-500 to-ambre-500"></div>

  <div class="conteneur py-12 md:py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2.5">
          <img
            src="/logo-horizonecole.png"
            alt=""
            width="36"
            height="36"
            loading="lazy"
            decoding="async"
            class="h-9 w-9 shrink-0"
          />
          {/* Sur fond bleu-encre, « Horizon » passe en blanc : le #171F3F de la
              marque y serait invisible. L'ambre, lui, ressort et reste fidèle. */}
          <span class="font-display text-[1.05rem] font-bold tracking-tight">
            <span class="text-white">Horizon</span><span class="text-ambre-500">Ecole</span>
          </span>
        </div>

        <p class="mt-4 max-w-xs text-legende leading-relaxed text-ink-200">
          Logiciel de gestion scolaire pour les établissements ivoiriens.
          Du CP1 à la Terminale.
        </p>

        <dl class="mt-6 space-y-2.5 text-legende">
          <div class="flex items-start gap-2.5">
            <dt class="sr-only">Ville</dt>
            <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"
                 class="mt-0.5 shrink-0 text-ambre-500">
              <path d="M8 1.8c-2.3 0-4.2 1.9-4.2 4.2 0 3.1 4.2 8.2 4.2 8.2s4.2-5.1 4.2-8.2c0-2.3-1.9-4.2-4.2-4.2Z"
                    fill="none" stroke="currentColor" stroke-width="1.3" />
              <circle cx="8" cy="6" r="1.5" fill="currentColor" />
            </svg>
            <dd class="text-ink-200">{CONTACT.ville}</dd>
          </div>

          <div class="flex items-start gap-2.5">
            <dt class="sr-only">Téléphone</dt>
            <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"
                 class="mt-0.5 shrink-0 text-ambre-500">
              <path d="M3 3.5c0-.6.4-1 1-1h1.6c.4 0 .8.3.9.7l.7 2.2c.1.4 0 .8-.3 1l-1 .8a8.5 8.5 0 0 0 3.4 3.4l.8-1c.2-.3.6-.4 1-.3l2.2.7c.4.1.7.5.7.9V13c0 .6-.4 1-1 1A10.5 10.5 0 0 1 3 3.5Z"
                    fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
            </svg>
            <dd class="space-y-1">
              {CONTACT.telephones.map((tel) => (
                <a href={tel.lien} class="block text-ink-200 transition-colors hover:text-white">
                  {tel.affichage}
                </a>
              ))}
            </dd>
          </div>

          <div class="flex items-start gap-2.5">
            <dt class="sr-only">E-mail</dt>
            <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"
                 class="mt-0.5 shrink-0 text-ambre-500">
              <rect x="1.8" y="3.4" width="12.4" height="9.2" rx="1.4" fill="none"
                    stroke="currentColor" stroke-width="1.3" />
              <path d="m2.4 4.6 5.6 4 5.6-4" fill="none" stroke="currentColor" stroke-width="1.3"
                    stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <dd>
              <a href={`mailto:${CONTACT.email}`} class="text-ink-200 transition-colors hover:text-white">
                {CONTACT.email}
              </a>
            </dd>
          </div>

        </dl>
      </div>

      {PIED_DE_PAGE.map((colonne) => (
        <div>
          <h2 class="text-[0.7rem] font-bold uppercase tracking-[0.08em] text-ambre-500">
            {colonne.titre}
          </h2>
          <ul class="mt-4 space-y-2.5">
            {colonne.liens.map((lien) => (
              <li>
                <a
                  href={lien.href}
                  class="inline-flex min-h-[28px] items-center text-legende text-ink-200
                         transition-colors hover:text-white"
                >
                  {lien.libelle}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-6 text-legende text-ink-300
             sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {annee} HorizonEcole. Tous droits réservés.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a href="/confidentialite" class="transition-colors hover:text-white">Confidentialité</a></li>
      </ul>
    </div>
  </div>
</footer>
