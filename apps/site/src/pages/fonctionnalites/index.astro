---
import Base from '@/layouts/Base.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import Icone from '@/components/Icone.astro';
import { PAGES_FONCTIONNALITES } from '@/lib/fonctionnalites';

/*
 * Page unique : tout le périmètre fonctionnel tient ici, sans sous-pages.
 *
 * Un menu déroulant obligeait le visiteur à choisir un espace avant d'avoir lu
 * quoi que ce soit — or un directeur qui découvre le produit ne sait pas encore
 * si son sujet relève de « l'espace Administration » ou du domaine « Scolarité
 * & finances ». Le sommaire ci-dessous joue le rôle du menu, mais après la
 * lecture du premier écran, et sans quitter la page.
 */
const espaces = PAGES_FONCTIONNALITES.filter((p) =>
  ['proprietaire', 'administration', 'enseignants', 'eleves-parents'].includes(p.slug),
);
const domaines = PAGES_FONCTIONNALITES.filter((p) => !espaces.includes(p));

const ICONES: Record<string, Parameters<typeof Icone>[0]['nom']> = {
  proprietaire: 'proprietaire',
  administration: 'administration',
  enseignants: 'enseignant',
  'eleves-parents': 'parent',
  'scolarite-finances': 'paiement',
  'bulletins-notes': 'bulletin',
  'presences-vie-scolaire': 'presence',
  'paie-personnel': 'dossier',
};

const PASTILLES: Record<string, string> = {
  ink: 'pastille-ink',
  craie: 'pastille-craie',
  ambre: 'pastille-ambre',
};
const ACCENTS: Record<string, string> = { ink: '', craie: 'carte-craie', ambre: 'carte-ambre' };

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://horizonecole.com/' },
    { '@type': 'ListItem', position: 2, name: 'Fonctionnalités', item: 'https://horizonecole.com/fonctionnalites' },
  ],
};
---

<Base
  titre="Fonctionnalités"
  description="Tout ce que gère HorizonEcole : pilotage, élèves, inscriptions, notes et bulletins, présences, emploi du temps, frais de scolarité, paie et personnel."
  canonique="/fonctionnalites"
  jsonLd={jsonLd}
>
  <section class="fond-papier relative overflow-hidden border-b border-ardoise-200">
    <div
      class="pointer-events-none absolute -right-52 -top-44 h-[38rem] w-[38rem] rounded-full
             bg-[radial-gradient(circle,rgba(52,71,143,.10),transparent_65%)]"
      aria-hidden="true"
    ></div>

    <div class="conteneur relative py-14 md:py-20">
      <nav aria-label="Fil d’ariane" class="mb-6 text-legende text-ardoise-500">
        <a href="/" class="hover:text-ink-600">Accueil</a>
        <span class="mx-2" aria-hidden="true">›</span>
        <span aria-current="page">Fonctionnalités</span>
      </nav>

      <h1 class="max-w-4xl text-[2.15rem] leading-[1.12] tracking-tight sm:text-[2.6rem] lg:text-display-xl">
        Tout ce que gère une école, dans un seul outil
      </h1>
      <div class="mt-4 h-[3px] w-16 rounded bg-ambre-600" aria-hidden="true"></div>
      <p class="mt-6 max-w-2xl text-chapo text-ardoise-600">
        Le périmètre couvert est celui du quotidien réel d’un établissement ivoirien —
        pas une liste d’intentions. Cinq espaces utilisateurs, quatre domaines métier.
      </p>

      <!-- Sommaire : le menu déroulant supprimé se retrouve ici, sous forme
           d'ancres. Le visiteur choisit après avoir lu, pas avant. -->
      <div class="mt-10">
        <p class="text-[0.72rem] font-bold uppercase tracking-[0.08em] text-ardoise-500">
          Aller directement à
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {PAGES_FONCTIONNALITES.map((page) => (
            <li>
              <a
                href={`#${page.slug}`}
                class="inline-flex min-h-[44px] items-center gap-2 rounded-bouton border
                       border-ardoise-200 bg-white/80 px-3.5 text-legende font-semibold
                       text-ardoise-700 backdrop-blur-sm transition-all duration-200
                       hover:-translate-y-0.5 hover:border-ink-300 hover:text-ink-700
                       hover:shadow-douce"
              >
                <span class={`shrink-0 ${page.accent === 'craie' ? 'text-craie-600' : page.accent === 'ambre' ? 'text-ambre-800' : 'text-ink-600'}`}>
                  <Icone nom={ICONES[page.slug]} taille={16} />
                </span>
                {page.titre}
                {page.option && <span class="badge-ambre">Option</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────── Par espace ─────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <SectionHeader
        titre="Par espace"
        chapo="Chaque profil dispose de sa propre interface et de ses propres droits — et ne voit rien d’autre."
      />

      <div class="mt-12 space-y-14">
        {espaces.map((page) => (
          <article id={page.slug} class="scroll-mt-24">
            <header class="flex flex-wrap items-center gap-4">
              <span class={`pastille ${PASTILLES[page.accent]}`}>
                <Icone nom={ICONES[page.slug]} taille={22} />
              </span>
              <div>
                <h3 class="text-display-md">{page.titre}</h3>
                <p class="text-legende text-ardoise-500">{page.h1}</p>
              </div>
            </header>
            <p class="mt-5 max-w-3xl text-ardoise-600">{page.chapo}</p>

            <div class="mt-7 grid gap-5 md:grid-cols-2">
              {page.blocs.map((bloc, i) => (
                <div class={`carte reveal ${ACCENTS[page.accent]}`} data-retard={(i % 2) + 1}>
                  <h4 class="text-[1.02rem] font-bold text-ink-900">{bloc.titre}</h4>
                  <p class="mt-2.5 text-legende leading-relaxed text-ardoise-600">{bloc.texte}</p>
                </div>
              ))}
            </div>

            <a href="/demonstration" class={`btn-tertiaire mt-7 ${page.accent === 'craie' ? 'btn-tertiaire-craie' : page.accent === 'ambre' ? 'btn-tertiaire-ambre' : ''}`}>
              <span class="etiquette">Voir cet espace en démonstration</span>
              <span class="puce-fleche"><Icone nom="fleche" taille={13} /></span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────────────────── Par domaine ────────────────────────── -->
  <section class="section bg-ardoise-0">
    <div class="conteneur">
      <SectionHeader
        titre="Par domaine"
        chapo="Les mêmes fonctionnalités, vues cette fois par sujet de gestion."
      />

      <div class="mt-12 space-y-14">
        {domaines.map((page) => (
          <article id={page.slug} class="scroll-mt-24">
            <header class="flex flex-wrap items-center gap-4">
              <span class={`pastille ${PASTILLES[page.accent]}`}>
                <Icone nom={ICONES[page.slug]} taille={22} />
              </span>
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-display-md">{page.titre}</h3>
                  {page.option && <span class="badge-ambre">Module optionnel</span>}
                </div>
                <p class="text-legende text-ardoise-500">{page.h1}</p>
              </div>
            </header>
            <p class="mt-5 max-w-3xl text-ardoise-600">{page.chapo}</p>

            <div class="mt-7 grid gap-5 md:grid-cols-2">
              {page.blocs.map((bloc, i) => (
                <div class={`carte reveal ${ACCENTS[page.accent]}`} data-retard={(i % 2) + 1}>
                  <h4 class="text-[1.02rem] font-bold text-ink-900">{bloc.titre}</h4>
                  <p class="mt-2.5 text-legende leading-relaxed text-ardoise-600">{bloc.texte}</p>
                </div>
              ))}
            </div>

            <a href={page.option ? '/contact' : '/demonstration'} class={`btn-tertiaire mt-7 ${page.accent === 'craie' ? 'btn-tertiaire-craie' : page.accent === 'ambre' ? 'btn-tertiaire-ambre' : ''}`}>
              <span class="etiquette">
                {page.option ? 'Nous parler de ce module' : 'Le voir en démonstration'}
              </span>
              <span class="puce-fleche"><Icone nom="fleche" taille={13} /></span>
            </a>
          </article>
        ))}
      </div>

      <p class="mt-12 max-w-3xl text-legende text-ardoise-500">
        Le module <strong>Paie &amp; personnel</strong> sort du périmètre scolaire : il se
        souscrit à part, et se chiffre après un point sur votre organisation. Tout le reste
        est compris dans l’abonnement, sans palier ni fonctionnalité réservée.
        <a href="/tarifs" class="lien">Voir les tarifs</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="conteneur">
      <div
        class="reveal relative overflow-hidden rounded-[20px] bg-ink-900 px-6 py-14
               text-center text-white sm:px-10 md:py-16"
      >
        <div
          class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full
                 bg-[radial-gradient(circle,rgba(204,135,34,.22),transparent_65%)]"
          aria-hidden="true"
        ></div>
        <div class="relative">
          <h2 class="mx-auto max-w-2xl text-display-lg !text-white">
            Le voir tourner sur vos propres classes
          </h2>
          <p class="mx-auto mt-5 max-w-xl text-chapo text-ink-100">
            Nous préparons la démonstration avec vos coefficients et votre grille de frais.
          </p>
          <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
            <a href="/demonstration" class="btn-sombre">
              Demander une démonstration
              <Icone nom="fleche" taille={15} classe="fleche" />
            </a>
            <a href="/tarifs" class="btn-contour-clair">Voir les tarifs</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
