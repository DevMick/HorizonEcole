---
import Base from '@/layouts/Base.astro';
import SectionHeader from '@/components/SectionHeader.astro';

/*
 * Cette page ne promet que ce qui est réellement implémenté. Toute mention de
 * certification (ISO, SOC) est proscrite tant qu'elle n'est pas obtenue, et
 * chaque affirmation doit être vérifiable dans le code ou dans le contrat.
 */
const engagements = [
  {
    titre: 'Les données appartiennent à l’établissement',
    texte: 'Nous en sommes dépositaires, pas propriétaires. À tout moment, vous pouvez obtenir un export complet — base de données et documents PDF — sans frais et sans justification.',
  },
  {
    titre: 'Cloisonnement entre établissements',
    texte: 'Chaque établissement dispose d’un périmètre de données strictement séparé. Aucune requête ne peut atteindre les données d’un autre établissement.',
  },
  {
    titre: 'Comptes et accès',
    texte: 'Les mots de passe sont chiffrés et jamais stockés en clair. Les sessions reposent sur des jetons à durée limitée. Les droits sont attribués par rôle, et un utilisateur n’accède qu’à ce que son rôle autorise.',
  },
  {
    // Vérifiable : les 25 routes de l'espace Propriétaire sont des GET, sans
    // aucun verbe d'écriture. C'est une garantie d'architecture, pas un réglage.
    titre: 'L’espace Propriétaire ne peut rien modifier',
    texte: 'Le propriétaire consulte les indicateurs de son établissement sans disposer d’aucune fonction d’écriture : cet espace lit, il n’édite pas. Aucune note, aucun paiement, aucun dossier ne peut y être modifié. La séparation ne tient pas à un réglage que l’on pourrait desserrer, mais à la construction même de l’espace — et chaque domaine peut en outre lui être ouvert ou fermé indépendamment.',
  },
  {
    titre: 'Journal d’audit',
    texte: 'Les actions sensibles — modification de note, suppression, encaissement — sont horodatées et attribuées à leur auteur.',
  },
  {
    titre: 'Connexion chiffrée',
    texte: 'Tous les échanges passent en HTTPS. Les en-têtes de sécurité usuels sont appliqués : HSTS, protection contre le détournement de type et l’encadrement en iframe.',
  },
  {
    titre: 'Sauvegardes et restauration',
    texte: 'Les sauvegardes sont quotidiennes et permettent une restauration en cas d’incident. Leur périmètre exact dépend du mode d’hébergement retenu, qui se définit avec vous après l’acquisition du logiciel.',
  },
  {
    titre: 'Mises à jour',
    texte: 'Les correctifs et les évolutions fonctionnelles de l’année en cours sont compris dans l’abonnement.',
  },
  {
    titre: 'Données de mineurs',
    texte: 'Les données scolaires sont traitées pour le seul usage de l’établissement. Elles ne sont ni revendues, ni exploitées à des fins publicitaires, ni utilisées pour entraîner un quelconque système.',
  },
];
---

<Base
  titre="Sécurité & données"
  description="Propriété des données, cloisonnement entre établissements, chiffrement, journal d’audit et réversibilité : les engagements d’HorizonEcole."
  canonique="/securite"
>
  <section class="border-b border-ardoise-200 bg-ink-50/50">
    <div class="conteneur py-14 md:py-20">
      <h1 class="max-w-3xl text-display-xl">Vos données appartiennent à votre établissement</h1>
      <div class="mt-3 h-[3px] w-16 rounded bg-ambre-600" aria-hidden="true"></div>
      <p class="mt-6 max-w-2xl text-chapo text-ardoise-600">
        Confier les dossiers de ses élèves à un tiers demande des garanties précises.
        Voici les nôtres, sans formule creuse.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="conteneur">
      <div class="grid gap-6 md:grid-cols-2">
        {engagements.map((e) => (
          <article class="carte">
            <h2 class="text-display-md">{e.titre}</h2>
            <p class="mt-3 text-ardoise-600">{e.texte}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-ardoise-0">
    <div class="conteneur max-w-3xl">
      <SectionHeader
        titre="En cas de fin de contrat"
        chapo="La réversibilité n’est pas une option commerciale, c’est une condition d’usage."
      />
      <ol class="mt-8 space-y-4">
        {[
          'Vous demandez l’export. Nous le fournissons dans un format ouvert, exploitable sans notre logiciel.',
          'Vous vérifiez son exhaustivité. Nous restons disponibles pendant cette vérification.',
          'Vous demandez la suppression. Nous l’exécutons et vous le confirmons par écrit.',
        ].map((etape, i) => (
          <li class="flex gap-4">
            <span class="chiffre shrink-0 text-legende !text-ambre-800">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="text-ardoise-700">{etape}</p>
          </li>
        ))}
      </ol>
      <p class="mt-8 text-legende text-ardoise-500">
        Nous n’affichons aucune certification que nous n’avons pas obtenue. Si un point
        de cette page vous paraît insuffisamment précis pour votre conseil d’administration,
        <a href="/contact" class="lien">écrivez-nous</a> : nous répondons par écrit.
      </p>
    </div>
  </section>
</Base>
