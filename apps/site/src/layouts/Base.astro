---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  titre: string;
  description: string;
  /** Chemin canonique sans domaine, ex. « /tarifs ». */
  canonique?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { titre, description, canonique, jsonLd } = Astro.props;
const url = new URL(canonique ?? Astro.url.pathname, Astro.site ?? 'https://horizonecole.com');
const titreComplet = titre.includes('HorizonEcole') ? titre : `${titre} — HorizonEcole`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url.href} />

    <!-- Seule la variante du H1 est préchargée : le reste se charge en swap,
         pour ne pas retarder le LCP sur un réseau lent. -->
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin-700-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HorizonEcole" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url.href} />
    <meta property="og:locale" content="fr_CI" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />

    <script is:inline>
      // Marque le document avant le premier rendu : sans cela, les blocs à
      // révéler s'afficheraient puis disparaîtraient. La classe n'est posée que
      // si l'API existe et que l'utilisateur n'a pas demandé moins de mouvement
      // — dans les deux cas, le contenu reste visible d'emblée.
      (function () {
        try {
          var calme = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if ('IntersectionObserver' in window && !calme) {
            document.documentElement.classList.add('js');
          }
        } catch (e) {}
      })();
    </script>

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[70]
             focus:rounded-bouton focus:bg-ink-600 focus:px-4 focus:py-2 focus:text-white"
    >Aller au contenu principal</a>

    <Header />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Apparition au défilement. Script en ligne, et non chargé depuis un
      // fichier : la classe « js » ayant déjà masqué les blocs, une requête qui
      // échoue laisserait la page vide. Ici, si le document s'affiche, le code
      // s'exécute.
      (function () {
        var blocs = document.querySelectorAll('.reveal');
        if (!blocs.length) return;

        var observateur = new IntersectionObserver(
          function (entrees) {
            entrees.forEach(function (entree) {
              if (!entree.isIntersecting) return;
              entree.target.classList.add('est-visible');
              // Une seule apparition par élément : on ne rejoue pas
              // l'animation quand l'utilisateur remonte la page.
              observateur.unobserve(entree.target);
            });
          },
          // Déclenchement légèrement avant l'entrée dans le cadre, pour que le
          // bloc soit déjà en place quand il devient lisible.
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
        );

        blocs.forEach(function (bloc) {
          observateur.observe(bloc);
        });

        // Filet de sécurité : si un bloc n'a jamais été observé (page très
        // courte, restauration de position, onglet en arrière-plan), il devient
        // visible au bout de deux secondes plutôt que de rester masqué.
        setTimeout(function () {
          blocs.forEach(function (bloc) {
            bloc.classList.add('est-visible');
          });
        }, 2000);
      })();
    </script>
  </body>
</html>
